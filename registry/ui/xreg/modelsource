    "*": {
      "type": "any"
    }
  },
  "groups": {
    "dirs": {
      "singular": "dir",
      "description": "Just a collection of stuff",
      "icon": "http://soaphub.org/svgen/folder/Dir",
      "attributes": {
        "format": {
          "type": "string"
        },
        "*": {
          "type": "any"
        }
      },
      "resources": {
        "files": {
          "singular": "file",
          "description": "A file store file",
          "icon": "http://soaphub.org/svgen/file/File",
          "hasdocument": true,
          "validateformat": true,
          "validatecompatibility": true,
          "attributes": {
            "*": {
              "type": "any"
            }
          }
        },
        "events": {
          "singular": "event",
          "description": "Describe an event",
          "icon": "http://soaphub.org/svgen/file/Event",
          "hasdocument": false,
          "attributes": {
            "*": {
              "type": "any"
            }
          }
        }
      }
    }
